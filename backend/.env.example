# Copy this file to .env (or export these as real environment variables) and fill in real
# values. Never commit the real .env file — it is already in .gitignore.
#
# JWT_SECRET and ENCRYPTION_SECRET_KEY have NO default value in application.yml: the app will
# refuse to start if either is missing. Generate strong random values with:
#   openssl rand -hex 32

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/twisungane
DB_USER=postgres
DB_PASSWORD=change-me

# --- Security secrets (required, no defaults) ---
# 64-char hex. Signs/verifies JWT session tokens.
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX
# 64-char hex. Encrypts PII (name, nationalId, phone) at rest via AES-256-GCM.
# NEVER change this after real data has been stored — existing rows become undecryptable.
ENCRYPTION_SECRET_KEY=REPLACE_WITH_DIFFERENT_64_CHAR_HEX

# --- CORS ---
# Comma-separated list of origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173

# --- Cookies ---
# Must be "true" in any deployment served over HTTPS.
COOKIE_SECURE=false

# --- Spring profile ---
SPRING_PROFILES_ACTIVE=dev
